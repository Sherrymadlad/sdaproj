<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="900" prefWidth="1600" style="-fx-background-color: #e6f0fa;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.testing2.controllers.NotificationsPageController">

    <!-- Sidebar -->
    <AnchorPane prefWidth="249.0" style="-fx-background-color: #f3e6f7; -fx-border-color: black;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <ImageView fitHeight="187.0" fitWidth="191.0" layoutX="31.0" layoutY="14.0"
                       preserveRatio="true">
                <image>
                    <Image url="@images/cart-removebg-preview.png" />
                </image>
            </ImageView>

            <VBox layoutX="3.0" layoutY="230.0" spacing="10">

                <Button fx:id="btnItems" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Items" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <Button fx:id="btnOrders" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Orders" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <Button fx:id="btnReports" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Reports" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <Button fx:id="btnProfile" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Profile" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Notifications Tab (Highlighted because we're here) -->
                <Button fx:id="btnNotifications" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #4b355a;" text="Notifications" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

            </VBox>
        </children>
    </AnchorPane>

    <!-- MAIN CONTENT -->
    <AnchorPane AnchorPane.leftAnchor="249.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                style="-fx-background-color: #e6f0fa;">

        <VBox spacing="25" layoutX="170" layoutY="70">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #4b355a;"
                       text="Low Stock Notifications" />
            </HBox>

            <!-- ScrollPane for notifications -->
            <ScrollPane fitToWidth="true" prefHeight="650" style="-fx-background-color: transparent;">
                <content>

                    <VBox fx:id="notificationsContainer" spacing="20">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                    </VBox>

                </content>
            </ScrollPane>

        </VBox>

    </AnchorPane>
</AnchorPane>
