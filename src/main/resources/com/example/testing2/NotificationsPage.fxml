<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="900" prefWidth="1600" style="-fx-background-color: #e6f0fa;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.NotificationsPageController">

    <!-- MAIN CONTENT -->
    <AnchorPane style="-fx-background-color: #e6f0fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="TOP_CENTER" spacing="25" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">

            <!-- Header -->
            <HBox alignment="CENTER" spacing="15">
                <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #4b355a;" text="Low Stock Notifications" />
            </HBox>

            <!-- Spacer to move the list down -->
            <Region prefHeight="30" />  <!-- adjust the height as needed -->

            <!-- ScrollPane for notifications -->
            <ScrollPane fitToWidth="true" prefHeight="700.0" prefWidth="1500.0" style="-fx-background-color: transparent;">
                <content>
                    <VBox fx:id="notificationsContainer" alignment="TOP_CENTER" spacing="20">
                        <padding>
                            <Insets bottom="10" left="10" right="10" top="10" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>

    </AnchorPane>
</AnchorPane>
