<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="Root" prefHeight="900" prefWidth="1351" style="-fx-background-color: #d7e3ee;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.CustomerOrdersPageController">

    <!-- TOP TAB BAR -->
    <HBox fx:id="tabBar" prefHeight="70" spacing="30.0" style="-fx-background-color: #d7e3ee; -fx-border-color: #c9bad6;" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <Button fx:id="btnCurrentOrders" prefHeight="70" prefWidth="300" style="-fx-background-color: #6d4c7d; -fx-text-fill: white; -fx-font-size: 20;" text="Current Orders" />

        <Button fx:id="btnPastOrders" prefHeight="70" prefWidth="300" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 20;" text="Past Orders" />

        <Button fx:id="btnRefundedOrders" prefHeight="70" prefWidth="300" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 20;" text="Refunded Orders" />
      <padding>
         <Insets bottom="5.0" left="30.0" top="5.0" />
      </padding>

    </HBox>

    <!-- SCROLLABLE ORDER LIST -->
    <ScrollPane fx:id="scrollOrders" fitToWidth="true"  fitToHeight="true" style="-fx-background-color: #d7e3ee;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="70">

        <content>
            <VBox fx:id="ordersContainer" spacing="20" style="-fx-background-color: #d7e3ee;">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>
            </VBox>
        </content>

    </ScrollPane>

</AnchorPane>
