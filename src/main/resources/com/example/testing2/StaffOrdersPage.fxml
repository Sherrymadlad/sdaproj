<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="900" prefWidth="1351" style="-fx-background-color: #d7e3ee;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.StaffOrdersPageController">

    <!-- Sidebar -->
    <AnchorPane prefWidth="249.0" style="-fx-background-color: #f3e6f7; -fx-border-color: black;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <ImageView fitHeight="187.0" fitWidth="191.0" layoutX="31.0" layoutY="14.0"
                       preserveRatio="true">
                <image>
                    <Image url="@images/cart-removebg-preview.png" />
                </image>
            </ImageView>

            <VBox layoutX="3.0" layoutY="230.0" spacing="10">
                <!-- Items Tab -->
                <Button fx:id="btnItems" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Items" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Orders Tab -->
                <Button fx:id="btnOrders" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Orders" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Reports Tab -->
                <Button fx:id="btnReports" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Reports" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Profile Tab -->
                <Button fx:id="btnProfile" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Profile" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>
            </VBox>
        </children>
    </AnchorPane>

    <!-- TOP TAB BAR -->
    <HBox fx:id="tabBar" prefHeight="70" spacing="0" style="-fx-background-color: #d7e3ee; -fx-border-color: #c9bad6;" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Button fx:id="btnOngoingOrders" prefHeight="70" prefWidth="300"
                style="-fx-background-color: #6d4c7d; -fx-text-fill: white; -fx-font-size: 20;"
                text="Ongoing Orders" />

        <Button fx:id="btnPastOrders" prefHeight="70" prefWidth="300"
                style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 20;"
                text="Past Orders" />

        <Button fx:id="btnRefundPendingOrders" prefHeight="70" prefWidth="300"
                style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 20;"
                text="Refund Pending Orders" />

    </HBox>

    <!-- SCROLLABLE ORDER LIST -->
    <ScrollPane fx:id="scrollOrders" fitToWidth="true" style="-fx-background-color: #d7e3ee;"
                AnchorPane.topAnchor="70" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <content>
            <VBox fx:id="ordersContainer" spacing="20" style="-fx-background-color: #d7e3ee;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
            </VBox>
        </content>

    </ScrollPane>

</AnchorPane>
