<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.testing2.controllers.StaffReportsController"
            prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #e6f0fa;"> <!-- faint blue background -->

    <!-- TabPane with two tabs, fully anchored -->
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: transparent; -fx-tab-min-width: 200; -fx-tab-max-width: 300;"
             AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
             AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <!-- Products Stock Tab -->
        <tabs>
            <Tab text="Products Stock">
                <AnchorPane style="-fx-background-color: transparent;">
                    <TableView fx:id="tblProductsStock"
                               style="-fx-background-color: #f0f8ff; -fx-border-color: #cce0ff; -fx-border-radius: 5; -fx-background-radius: 5;"
                               AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
                               AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
                        <columns>
                            <TableColumn fx:id="colProductId" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="colSKU" text="SKU" prefWidth="150"/>
                            <TableColumn fx:id="colProductName" text="Product Name" prefWidth="300"/>
                            <TableColumn fx:id="colPrice" text="Price" prefWidth="150"/>
                            <TableColumn fx:id="colTotalStock" text="Total Stock" prefWidth="150"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>

            <!-- Warehouse Stock Tab -->
            <Tab text="Warehouse Stock">
                <AnchorPane style="-fx-background-color: transparent;">
                    <TableView fx:id="tblWarehouseStock"
                               style="-fx-background-color: #f0f8ff; -fx-border-color: #cce0ff; -fx-border-radius: 5; -fx-background-radius: 5;"
                               AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
                               AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
                        <columns>
                            <TableColumn fx:id="colProductNameWH" text="Product Name" prefWidth="300"/>
                            <TableColumn fx:id="colWarehouseName" text="Warehouse" prefWidth="300"/>
                            <TableColumn fx:id="colQuantityAvailable" text="Available Stock" prefWidth="200"/>
                        </columns>
                    </TableView>
                </AnchorPane>
            </Tab>
        </tabs>
    </TabPane>

</AnchorPane>
