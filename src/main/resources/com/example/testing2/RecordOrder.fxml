<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.testing2.controllers.RecordOrderController">

    <children>
        <!-- Background -->
        <Pane prefWidth="1920" prefHeight="1080" style="-fx-background-color: #cad6de;">
            <children>

                <!-- Card -->
                <Pane layoutX="250" layoutY="150" prefWidth="1400" prefHeight="780"
                      style="-fx-background-color: #e5dae6; -fx-border-color: purple; -fx-border-width: 5; -fx-border-radius: 10;">
                    <children>

                        <!-- Title -->
                        <Text text="Record New Order" layoutX="500" layoutY="80" fill="#532386">
                            <font><Font size="42"/></font>
                        </Text>

                        <!-- Product ID -->
                        <Label text="Product ID:" layoutX="200" layoutY="160" />
                        <TextField fx:id="txtProductID" layoutX="400" layoutY="150" prefWidth="400" prefHeight="35"
                                   style="-fx-background-color: #E6E6FA; -fx-border-color: black;"/>

                        <!-- Customer ID -->
                        <Label text="Customer ID:" layoutX="200" layoutY="220" />
                        <TextField fx:id="txtCustomerID" layoutX="400" layoutY="210" prefWidth="400" prefHeight="35"
                                   style="-fx-background-color: #E6E6FA; -fx-border-color: black;"/>

                        <!-- Quantity -->
                        <Label text="Quantity:" layoutX="200" layoutY="280" />
                        <TextField fx:id="txtQuantity" layoutX="400" layoutY="270" prefWidth="400" prefHeight="35"
                                   style="-fx-background-color: #E6E6FA; -fx-border-color: black;"/>

                        <!-- Unit Price -->
                        <Label text="Unit Price:" layoutX="200" layoutY="340" />
                        <TextField fx:id="txtUnitPrice" layoutX="400" layoutY="330" prefWidth="400" prefHeight="35"
                                   style="-fx-background-color: #E6E6FA; -fx-border-color: black;"/>

                        <!-- Total Price -->
                        <Label text="Total Price:" layoutX="200" layoutY="400" />
                        <TextField fx:id="txtTotalPrice" layoutX="400" layoutY="390" prefWidth="400" prefHeight="35"
                                   style="-fx-background-color: #E6E6FA; -fx-border-color: black;" editable="false"/>

                        <!-- Submit Order Button -->
                        <Button text="Submit Order"
                                layoutX="400" layoutY="480"
                                prefWidth="180" prefHeight="50"
                                textFill="#532386"
                                style="-fx-background-color: #FFF0F5; -fx-border-color: black;"
                                onAction="#submitOrder">
                            <font><Font size="20"/></font>
                        </Button>

                        <!-- Back Button -->
                        <Button text="Back"
                                layoutX="650" layoutY="480"
                                prefWidth="180" prefHeight="50"
                                textFill="#532386"
                                style="-fx-background-color: #FFF0F5; -fx-border-color: black;"
                                onAction="#goBack">
                            <font><Font size="20"/></font>
                        </Button>

                    </children>
                </Pane>

            </children>
        </Pane>
    </children>
</AnchorPane>
