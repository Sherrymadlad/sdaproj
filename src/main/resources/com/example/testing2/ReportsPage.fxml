<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #cce0ff;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.testing2.controllers.ReportsPageController">

    <!-- Sidebar -->
    <AnchorPane prefWidth="250.0" style="-fx-background-color: #f3e6f7; -fx-border-color: black;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <ImageView fitHeight="150.0" fitWidth="150.0" layoutX="50.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/cart-removebg-preview.png" />
                </image>
            </ImageView>

            <Button fx:id="btnMetrics" layoutX="5.0" layoutY="200.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Metrics" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnReports" layoutX="5.0" layoutY="270.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Reports" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnAudit" layoutX="5.0" layoutY="350.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Audit Logs" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnAdminProfile" layoutX="5.0" layoutY="430.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Profile" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

        </children>
    </AnchorPane>

    <!-- Main Content -->
    <AnchorPane layoutX="250" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="250" AnchorPane.rightAnchor="0">

        <!-- Top Tabs -->
        <HBox fx:id="tabBar" prefHeight="70" spacing="0" style="-fx-background-color: #d7e3ee; -fx-border-color: #c9bad6;"
              AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <children>
                <Button fx:id="btnStockReport" prefHeight="70" prefWidth="200"
                        style="-fx-background-color: #6d4c7d; -fx-text-fill: white; -fx-font-size: 18;"
                        text="Stock Availability"/>
                <Button fx:id="btnSupplierReport" prefHeight="70" prefWidth="200"
                        style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18;"
                        text="Supplier Performance"/>
                <Button fx:id="btnSalesStockReport" prefHeight="70" prefWidth="200"
                        style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18;"
                        text="Sales vs Stock"/>
                <Button fx:id="btnMovementReport" prefHeight="70" prefWidth="200"
                        style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18;"
                        text="Slow vs Fast Moving"/>
            </children>
        </HBox>

        <!-- Scrollable Reports Container -->
        <ScrollPane fx:id="scrollReports" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-border-color: transparent;"
                    AnchorPane.topAnchor="70" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <content>
                <VBox fx:id="reportsContainer" spacing="15">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

    </AnchorPane>



</AnchorPane>
