<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: #d7e3ee;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.ReportsPageController">

    <!-- Main Content -->
    <AnchorPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- Top Tabs -->
        <HBox fx:id="tabBar" alignment="CENTER_LEFT" prefWidth="Infinity" prefHeight="70" spacing="30.0" style="-fx-background-color: #d7e3ee; -fx-border-color: #c9bad6; -fx-font-family: 'Arial'; -fx-font-weight: bold;">
            <children>
                <Button fx:id="btnStockReport" prefHeight="70" prefWidth="200" style="-fx-background-color: #6d4c7d; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Stock Availability">
               <font>
                  <Font size="18.0" />
               </font></Button>
                <Button fx:id="btnSupplierReport" prefHeight="70" prefWidth="230" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Supplier Performance" />
                <Button fx:id="btnSalesStockReport" prefHeight="70" prefWidth="200" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Sales vs Stock" />
                <Button fx:id="btnMovementReport" prefHeight="70" prefWidth="240" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" text="Slow vs Fast Moving">
               <font>
                  <Font size="18.0" />
               </font></Button>
            </children>
         <padding>
            <Insets bottom="5.0" left="15.0" top="5.0" />
         </padding>
        </HBox>

        <ScrollPane fx:id="scrollReports" fitToWidth="true" style="-fx-background-color: #d7e3ee; -fx-border-color: #d7e3ee;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="70">
            <content>
                <VBox fx:id="reportsContainer" spacing="15" style="-fx-background-color: #d7e3ee; -fx-border-color: #d7e3ee;">
                    <padding>
                        <Insets bottom="10" left="10" right="10" top="10" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

    </AnchorPane>



</AnchorPane>
