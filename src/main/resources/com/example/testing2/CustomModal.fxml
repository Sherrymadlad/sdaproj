<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="modalRoot" alignment="CENTER"
           style="-fx-background-color: rgba(0,0,0,0.35);"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.testing2.controllers.CustomModalController"
           visible="false">

    <AnchorPane style="-fx-background-color: #FFF0F5;
                       -fx-border-color: #8b6fa1;
                       -fx-border-width: 2;
                       -fx-background-radius: 20;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 12,0,0,4);"
                prefWidth="400" prefHeight="200"
                maxWidth="400" maxHeight="200" minWidth="400" minHeight="200">

        <children>
            <Text fx:id="modalMessage"
                  style="-fx-fill: #532386; -fx-font-size: 18; -fx-font-weight: bold;"
                  wrappingWidth="360"
                  text="Message goes here"
                  layoutX="20" layoutY="50" />

            <!-- OK Button for normal messages -->
            <Button fx:id="btnOk" text="OK"
                    prefWidth="120" prefHeight="40"
                    style="-fx-background-color: linear-gradient(to bottom, #8b6fa1, #b694c4);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 16px;
                           -fx-background-radius: 15;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4,0,0,2);"
                    layoutX="140" layoutY="130" />

            <!-- Confirmation Buttons for Yes/No -->
            <HBox fx:id="confirmationButtons" spacing="20"
                  layoutX="90" layoutY="130" visible="false" alignment="CENTER">
                <children>
                    <Button fx:id="btnYes" text="Yes"
                            prefWidth="120" prefHeight="40"
                            style="-fx-background-color: linear-gradient(to bottom, #4CAF50, #66BB6A);
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 16px;
                                   -fx-background-radius: 15;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4,0,0,2);" />
                    <Button fx:id="btnNo" text="No"
                            prefWidth="120" prefHeight="40"
                            style="-fx-background-color: linear-gradient(to bottom, #F44336, #E57373);
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 16px;
                                   -fx-background-radius: 15;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4,0,0,2);" />
                </children>
            </HBox>

        </children>
    </AnchorPane>
</StackPane>
