<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #d7e3ee;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.AuditPageController">
    <!-- Sidebar -->
    <AnchorPane prefWidth="250.0" style="-fx-background-color: #f3e6f7; -fx-border-color: black;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <ImageView fitHeight="150.0" fitWidth="150.0" layoutX="50.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@images/cart-removebg-preview.png" />
                </image>
            </ImageView>

            <Button fx:id="btnMetrics" layoutX="5.0" layoutY="200.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Metrics" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnReports" layoutX="5.0" layoutY="270.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Reports" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnAudit" layoutX="5.0" layoutY="350.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Audit Logs" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

            <Button fx:id="btnAdminProfile" layoutX="5.0" layoutY="430.0" prefHeight="50.0" prefWidth="240.0" style="-fx-background-color: #8b6fa1;" text="Profile" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Button>

        </children>
    </AnchorPane>


    <!-- Audit Logs Pane -->
    <VBox spacing="10" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="270" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <ScrollPane fx:id="scrollAudit" fitToWidth="true" prefHeight="724.0" prefWidth="610.0" style="-fx-background: black;">
            <content>
                <VBox fx:id="auditList" spacing="8" style="-fx-background-color: black;">
                    <!-- Audit log entries will be dynamically added here by the controller -->
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</AnchorPane>
