<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.testing2.controllers.UpdateStatusController"
            prefWidth="600" prefHeight="400">

    <Label text="Update Order Status" layoutX="30" layoutY="20" style="-fx-font-size: 22;" />

    <Label text="Order ID:" layoutX="30" layoutY="80"/>
    <TextField fx:id="orderIdField" layoutX="150" layoutY="75" prefWidth="200"/>

    <Label text="New Status:" layoutX="30" layoutY="140"/>
    <ComboBox fx:id="statusCombo" layoutX="150" layoutY="135" prefWidth="200"/>

    <Button text="Update" layoutX="150" layoutY="200" onAction="#updateStatus"/>

    <Button text="Back" layoutX="30" layoutY="350" onAction="#goBack"/>

</AnchorPane>
