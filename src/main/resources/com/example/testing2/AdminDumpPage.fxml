<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #d7e3ee;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.testing2.controllers.AdminDumpPageController"
            fx:id="rootPane">


    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <Button fx:id="btnDownloadDump"
                prefHeight="60.0"
                prefWidth="250.0"
                text="Generate Database Dump"
                style="
            -fx-background-color: #8b6fa1;
            -fx-text-fill: white;
            -fx-font-size: 18px;
            -fx-font-weight: bold;
            -fx-background-radius: 12;
            -fx-cursor: hand;
        " />

        <Label alignment="CENTER"
               wrapText="true"
               style="-fx-font-size: 14px;"
               text="Check app directory for a file called backup_1764877737090.sql" />
    </VBox>

</AnchorPane>
