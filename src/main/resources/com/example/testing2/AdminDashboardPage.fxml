<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>
<?import javafx.fxml.FXMLLoader?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #d7e3ee;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.testing2.controllers.AdminDashboardController">

    <!-- LEFT SIDEBAR (now dynamic) -->
    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </left>

    <!-- TOP TABS & MAIN CONTENT WRAPPER -->
    <center>
        <AnchorPane>

            <!-- Top Tabs -->
            <HBox layoutX="10.0" layoutY="10.0" spacing="10">
                <children>
                    <Button fx:id="tabMetrics" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: #8b6fa1; -fx-text-fill: white;" text="Metrics"/>
                    <Button fx:id="tabUsers" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: #c2add3; -fx-text-fill: #4b355a;" text="Users"/>
                    <Button fx:id="tabProducts" prefHeight="50.0" prefWidth="220.0"
                            style="-fx-background-color: #c2add3; -fx-text-fill: #4b355a;" text="Products"/>
                </children>
            </HBox>

            <!-- MAIN CONTENT AREA -->
            <AnchorPane fx:id="mainContent"
                        layoutY="70"
                        AnchorPane.topAnchor="70.0"
                        AnchorPane.bottomAnchor="0.0"
                        AnchorPane.leftAnchor="0.0"
                        AnchorPane.rightAnchor="0.0"
                        style="-fx-background-color: #d7e3ee;">
            </AnchorPane>

        </AnchorPane>
    </center>

</BorderPane>
