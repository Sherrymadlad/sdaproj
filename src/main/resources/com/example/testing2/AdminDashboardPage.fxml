<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane style="-fx-background-color: #d7e3ee;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.AdminDashboardController">

    <!-- Sidebar -->
    <AnchorPane fx:id="sidebarContainer" prefWidth="339" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" />

    <!-- Header (Top Tabs) -->
    <HBox fx:id="header" prefHeight="60" spacing="30.0" AnchorPane.leftAnchor="339" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

        <children>
            <Button fx:id="tabMetrics" prefHeight="50" prefWidth="200" style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-font-weight: bold;" text="Metrics">
            <font>
               <Font size="18.0" />
            </font></Button>

            <Button fx:id="tabUsers" prefHeight="50" prefWidth="200" style="-fx-background-color: #c2add3; -fx-text-fill: #4b355a; -fx-font-weight: bold;" text="Users">
            <font>
               <Font size="18.0" />
            </font></Button>

            <Button fx:id="tabProducts" prefHeight="50" prefWidth="200" style="-fx-background-color: #c2add3; -fx-text-fill: #4b355a; -fx-font-weight: bold;" text="Products">
            <font>
               <Font size="18.0" />
            </font></Button>
        </children>
      <padding>
         <Insets bottom="5.0" left="30.0" top="5.0" />
      </padding>

    </HBox>

    <!-- Main Content -->
    <AnchorPane fx:id="mainContent" style="-fx-background-color: #d7e3ee;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="339" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="70">

        <children>
            <!-- Metrics Section Example -->
            <Text fx:id="txtTotalUsers" layoutX="50" layoutY="50" style="-fx-font-size: 24px;" text="0" />
            <Text fx:id="txtTotalOrders" layoutX="50" layoutY="100" style="-fx-font-size: 24px;" text="0" />
            <Text fx:id="txtTotalRevenue" layoutX="50" layoutY="150" style="-fx-font-size: 24px;" text="0" />
        </children>

    </AnchorPane>

</AnchorPane>
