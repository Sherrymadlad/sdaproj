<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" style="-fx-background-color: #d7e3ee;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.ManagerMainPageController">

    <!-- Sidebar Placeholder -->
    <AnchorPane fx:id="sidebarContainer" layoutX="0" layoutY="0" prefWidth="339" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0" />

    <!-- Main Content Area -->
    <AnchorPane fx:id="mainContent" layoutX="338.0" prefHeight="650.0" prefWidth="654.0" style="-fx-background-color: #d7e3ee;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="338.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <!-- Header with Search -->
            <AnchorPane prefHeight="90.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <children>
                    <Text layoutX="30.0" layoutY="40.0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #6d4c7d;" text="Manager Dashboard" />

                    <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="250.0" promptText="Search products..." style="-fx-border-radius: 10; -fx-border-width: 2; -fx-background-radius: 10;" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </TextField>

                    <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="280.0" AnchorPane.topAnchor="32.0">
                        <image>
                            <Image url="@images/icon-removebg-preview.png" />
                        </image>
                    </ImageView>
                </children>
            </AnchorPane>

            <!-- Products Table -->
            <TableView fx:id="productsTable" style="-fx-background-color: white;" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="150" text="Product Name" />
                    <TableColumn fx:id="colCategory" prefWidth="100" text="Category" />
                    <TableColumn fx:id="colPrice" prefWidth="80" text="Price" />
                    <TableColumn fx:id="colStock" prefWidth="80" text="Stock" />
                    <TableColumn fx:id="colDescription" text="Description" />
                </columns>
            </TableView>

            <!-- Action Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="15" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0">
                <Button fx:id="btnAddProduct" prefHeight="35" prefWidth="120" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5;" text="Add Product" />
                <Button fx:id="btnDeleteProduct" prefHeight="35" prefWidth="120" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5;" text="Delete Selected" />
                <Button fx:id="btnUpdateProduct" prefHeight="35" prefWidth="120" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 5;" text="Update Product" />
            </HBox>
        </children>
    </AnchorPane>

    <!-- Add/Edit Product Modal -->
    <StackPane fx:id="productModal" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false"
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <AnchorPane fx:id="modalContent" maxHeight="450" maxWidth="500" prefHeight="450" prefWidth="500"
                    style="-fx-background-color: white; -fx-background-radius: 20;">

            <!-- Close Button -->
            <Button fx:id="btnCloseModal" layoutX="445" layoutY="15" prefHeight="40" prefWidth="40"
                    style="-fx-background-color: transparent; -fx-font-size: 22px; -fx-text-fill: #444;" text="✕" />

            <!-- Modal Title -->
            <Text layoutX="25.0" layoutY="50.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #6d4c7d;" text="Add/Edit Product" />

            <!-- Form Container -->
            <VBox layoutX="25.0" layoutY="70.0" prefWidth="450" spacing="20">
                <padding>
                    <Insets top="20" />
                </padding>

                <!-- Product Form -->
                <VBox spacing="10">
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Product Name *" />
                            <TextField fx:id="txtProductName" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Category *" />
                            <ComboBox fx:id="cmbCategory" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Price *" />
                            <TextField fx:id="txtPrice" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Stock Quantity *" />
                            <TextField fx:id="txtStock" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Low Stock Threshold" />
                            <TextField fx:id="txtLowStock" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Supplier" />
                            <ComboBox fx:id="cmbSupplierName" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Description" />
                        <TextArea fx:id="txtDescription" prefHeight="100" prefWidth="415" wrapText="true" />
                    </VBox>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button fx:id="btnCancel" prefWidth="100" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 5;" text="Cancel" />
                    <Button fx:id="btnSaveProduct" prefWidth="120" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;" text="Save Product" />
                </HBox>
            </VBox>
        </AnchorPane>
    </StackPane>
</AnchorPane>
