<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<AnchorPane maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="-Infinity" style="-fx-background-color: #d7e3ee;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.testing2.controllers.ManagerMainPageController">

    <!-- Sidebar -->
    <AnchorPane fx:id="sidebarContainer" layoutX="0" layoutY="0" prefWidth="339" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0" />

    <!-- Main Content -->
    <AnchorPane fx:id="mainContent" layoutX="338.0" prefHeight="622.0" prefWidth="526.0" style="-fx-background-color: #d7e3ee;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="338.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <children>
            <!-- Header: Search and Filters -->
            <AnchorPane fx:id="header" prefHeight="140.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <children>
                    <TextField fx:id="txtSearch" promptText="Search items..." style="-fx-border-radius: 10; -fx-border-width: 5;" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="30.0" />

                    <ImageView fitHeight="36.6" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="45.0" AnchorPane.topAnchor="30.0">
                        <image>
                            <Image url="@images/icon-removebg-preview.png" />
                        </image>
                    </ImageView>

                    <HBox spacing="15" AnchorPane.leftAnchor="120.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="80.0">
                        <children>
                            <ComboBox fx:id="cmbFilterCategory" prefWidth="200.0" promptText="Filter by Category"/>
                            <ComboBox fx:id="cmbSortBy" prefWidth="200.0" promptText="Sort by"/>
                        </children>
                    </HBox>
                </children>
            </AnchorPane>

            <!-- Scrollable container -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" layoutY="127.2" pannable="true" prefHeight="495.0" prefWidth="615.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="127.0">
                <content>
                    <VBox fx:id="categoriesContainer" spacing="20" style="-fx-background-color: #d7e3ee;" />
                </content>
            </ScrollPane>

            <!-- Hidden template card -->
            <AnchorPane fx:id="itemCard" prefHeight="280.0" prefWidth="250.0" style="-fx-background-color: #fff; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10,0,0,3); -fx-cursor: hand;" visible="false" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
                <children>
                    <ImageView fx:id="imgItem" fitHeight="160.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                    <AnchorPane layoutY="160.0" prefHeight="120.0" prefWidth="250.0" style="-fx-background-color: #ffe6f0; -fx-background-radius: 0 0 15 15; -fx-padding: 12;">
                        <children>
                            <Text fx:id="txtItemName" fill="#532386" layoutX="12.0" layoutY="40.0" style="-fx-font-weight: bold; -fx-font-size: 18;" text="Item Name" wrappingWidth="160" />
                            <Text fx:id="txtStock" fill="#8b6fa1" layoutX="180.0" layoutY="40.0" style="-fx-font-weight: bold; -fx-font-size: 18;" text="Stock: 0" />
                        </children>
                    </AnchorPane>
                </children>
            </AnchorPane>
        </children>
    </AnchorPane>

    <StackPane fx:id="productModal" alignment="CENTER" visible="false"
               style="-fx-background-color: rgba(0,0,0,0.6);"
               AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <AnchorPane fx:id="modalContent" prefWidth="500" prefHeight="650"
                    maxWidth="500" maxHeight="650"
                    style="-fx-background-color: white; -fx-background-radius: 20;">

            <!-- Modal Close Button -->
            <Button fx:id="btnCloseProductModal" text="✕" layoutX="445" layoutY="15"
                    prefWidth="40" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-font-size: 22px; -fx-text-fill: #444;" />

            <!-- Modal Title -->
            <Text layoutX="25.0" layoutY="50.0" text="Add/Edit Product"
                  style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #6d4c7d;" />

            <!-- Form Content -->
            <VBox layoutX="25.0" layoutY="70.0" spacing="20" prefWidth="450">
                <padding>
                    <Insets top="20" />
                </padding>

                <!-- Product Image -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <ImageView fx:id="productModalImage" fitWidth="100" fitHeight="100"
                               preserveRatio="true"
                               style="-fx-background-color: #f0f0f0; -fx-background-radius: 10;" />
                    <Button fx:id="btnUploadProductImage" text="Upload Image"
                            style="-fx-background-color: #8b6fa1; -fx-text-fill: white; -fx-background-radius: 5;"
                            prefWidth="120" />
                </HBox>

                <!-- Product Form Fields -->
                <VBox spacing="10">
                    <!-- Name & Category -->
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Product Name *" />
                            <TextField fx:id="txtModalProductName" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Category *" />
                            <ComboBox fx:id="cmbModalCategory" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <!-- Price & Stock -->
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Price *" />
                            <TextField fx:id="txtModalPrice" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Stock Quantity *" />
                            <TextField fx:id="txtModalStock" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <!-- Low Stock & Supplier -->
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Low Stock Threshold" />
                            <TextField fx:id="txtModalLowStock" prefWidth="200" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Supplier" />
                            <TextField fx:id="txtModalSupplier" prefWidth="200" />
                        </VBox>
                    </HBox>

                    <!-- Description -->
                    <VBox spacing="5">
                        <Label text="Description" />
                        <TextArea fx:id="txtModalDescription" prefWidth="415" prefHeight="100"
                                  wrapText="true" />
                    </VBox>
                </VBox>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="btnModalCancel" text="Cancel"
                            style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-background-radius: 5;"
                            prefWidth="100" />
                    <Button fx:id="btnModalSaveProduct" text="Save Product"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;"
                            prefWidth="120" />
                </HBox>
            </VBox>
        </AnchorPane>
    </StackPane>

    <!-- Add this inside your main AnchorPane (mainContent) children -->
    <Button fx:id="btnAddProduct" text="+"
            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 28px; -fx-background-radius: 50%; -fx-cursor: hand;"
            prefWidth="60" prefHeight="60"
            AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0"/>


</AnchorPane>
