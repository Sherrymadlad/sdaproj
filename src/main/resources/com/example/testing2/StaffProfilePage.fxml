<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="900" prefWidth="1600" style="-fx-background-color: #e6f0fa;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.testing2.controllers.StaffProfilePageController">

    <!-- Sidebar -->
    <AnchorPane prefWidth="249.0" style="-fx-background-color: #f3e6f7; -fx-border-color: black;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <ImageView fitHeight="187.0" fitWidth="191.0" layoutX="31.0" layoutY="14.0"
                       preserveRatio="true">
                <image>
                    <Image url="@images/cart-removebg-preview.png" />
                </image>
            </ImageView>

            <VBox layoutX="3.0" layoutY="230.0" spacing="10">
                <!-- Items Tab -->
                <Button fx:id="btnItems" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Items" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Orders Tab -->
                <Button fx:id="btnOrders" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Orders" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Reports Tab -->
                <Button fx:id="btnReports" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Reports" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>

                <!-- Profile Tab -->
                <Button fx:id="btnProfile" prefHeight="49.0" prefWidth="243.0"
                        style="-fx-background-color: #8b6fa1;" text="Profile" textFill="WHITE">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Button>
            </VBox>
        </children>
    </AnchorPane>

    <!-- MAIN CONTENT AREA -->
    <AnchorPane fx:id="mainContent" style="-fx-background-color: #e6f0fa;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="249.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox layoutX="170.0" layoutY="150.0" spacing="25">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefHeight="46.0" prefWidth="343.0" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #4b355a;" text="Staff Profile" />
            </HBox>

            <!-- Username Field -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="150" style="-fx-font-size: 25; -fx-font-weight: bold; -fx-text-fill: #4a4a4a;" text="Username:" />
                <TextField fx:id="txtUsername" prefWidth="400" style="-fx-font-size: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c0c0c0; -fx-background-color: #ffffff; -fx-padding: 6 10 6 10;" />
                <Button fx:id="btnEditUsername" style="-fx-font-size: 18;" text="Edit" />
            </HBox>

            <!-- Password Field -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="150" style="-fx-font-size: 25; -fx-font-weight: bold; -fx-text-fill: #4a4a4a;" text="Password:" />
                <TextField fx:id="txtPassword" prefWidth="400" style="-fx-font-size: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c0c0c0; -fx-background-color: #ffffff; -fx-padding: 6 10 6 10;" />
                <Button fx:id="btnEditPassword" style="-fx-font-size: 18;" text="Edit" />
            </HBox>

            <!-- Address Field -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="150" style="-fx-font-size: 25; -fx-font-weight: bold; -fx-text-fill: #4a4a4a;" text="Address:" />
                <TextField fx:id="txtAddress" prefWidth="400" style="-fx-font-size: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c0c0c0; -fx-background-color: #ffffff; -fx-padding: 6 10 6 10;" />
                <Button fx:id="btnEditAddress" style="-fx-font-size: 18;" text="Edit" />
            </HBox>

            <!-- Phone Field -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="150" style="-fx-font-size: 25; -fx-font-weight: bold; -fx-text-fill: #4a4a4a;" text="Phone:" />
                <TextField fx:id="txtPhone" prefWidth="400" style="-fx-font-size: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c0c0c0; -fx-background-color: #ffffff; -fx-padding: 6 10 6 10;" />
                <Button fx:id="btnEditPhone" style="-fx-font-size: 18;" text="Edit" />
            </HBox>

            <!-- Email Field -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="150" style="-fx-font-size: 25; -fx-font-weight: bold; -fx-text-fill: #4a4a4a;" text="Email:" />
                <TextField fx:id="txtEmail" prefWidth="400" style="-fx-font-size: 20; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c0c0c0; -fx-background-color: #ffffff; -fx-padding: 6 10 6 10;" />
                <Button fx:id="btnEditEmail" style="-fx-font-size: 18;" text="Edit" />
            </HBox>

        </VBox>

    </AnchorPane>

</AnchorPane>
